from census import Census

# Replace with your activated API key
KEY = "241a8832aad094e87cce0746bb8eb93d0527e5ec"
c = Census(KEY)

# Fetch population (B01003_001E) for all places in California (06)
data = c.acs5.state_place(('NAME', 'B01003_001E'), Census.ALL,Census.ALL)

a = []
for entry in data:
    pop_str = entry.get('B01003_001E')

    # Ensure data exists before converting to int
    if pop_str is not None:
        pop = int(pop_str)
        if pop < 600000:
            a.append(entry['NAME'])

print(f"Found {len(a)} places with population < 600,000.")
