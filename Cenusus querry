from census import Census
import pandas as pd

KEY = "your_actual_40_character_api_key_here"
c = Census(KEY)

def get_filtered_cities():
    try:
        min_pop = int(input("Enter maximum population threshold (e.g., 500000): ").strip())
        min_income = int(input("Enter minimum median income threshold (e.g., 40000): ").strip())
    except ValueError:
        print("Invalid input. Please enter numeric values for population and income.")
        return {}

    print(f"\nQuerying Census Bureau ACS 5-Year estimates for cities with population < {min_pop:,} and income > ${min_income:,}...")

    try:
        # Variable B01003_001E = Total Population
        # Variable B19013_001E = Median Household Income in the past 12 months
        data = c.acs5.state_place(
            ('NAME', 'B01003_001E', 'B19013_001E'),
            Census.ALL,
            Census.ALL
        )
        
        # Dictionary to store the results categorized by city name
        cities_dict = {}
        
        for entry in data:
            name = entry.get('NAME')
            pop = entry.get('B01003_001E')
            income = entry.get('B19013_001E')

            if pop is not None and income is not None:
                if pop < min_pop and income > min_income:
                    # Save the metrics into a dictionary mapping the city name to its details
                    cities_dict[name] = {
                        "Population": pop,
                        "Median Income": income
                    }

        if cities_dict:
            print(f"\nSuccessfully stored {len(cities_dict)} cities into the dictionary.")
            print("\nPreview of stored dictionary contents:")
            
            # Fixed: convert items() to a list before slicing
            for city, details in list(cities_dict.items())[:5]:
                print(f"{city}: {details}")
                
            return cities_dict
        else:
            print("\nNo cities matched the specified criteria.")
            return {}

    except Exception as e:
        print(f"\nAn error occurred while communicating with the Census API: {e}")
        return {}

if __name__ == "__main__":
    result_dict = get_filtered_cities()
