        self.seed = 1
        self.drop = .1
        self.features = []
        self.regimes_to_trade = [2]
        self.trade_data = {'wins':0,'duration':[],'profit':0,'loss':0,'trades':0,'win_rate':0,'drawdown':0}
        self.first_date = pd.Timestamp(date.today())
        self.to_drop = []
        self.saved = []
        self.vol = ''
        self.ind = ''
        self.ind2 = ''
        self.base = ''
        self.strategy_type = 1
        self.baseline_ = {'ema':pta.ema,'rma':pta.rma,'sma':pta.sma,'pwma':pta.sma,'t3':pta.t3,'trima':pta.trima,'wma':pta.wma,'swma':pta.swma}
        self.length = 10

    def initialize(self,type):

        for i in self.stocks:
            if not isinstance(i, str):
                pass
            else:

                self.data[i] = yf.download(i)
                b = self.data[i].index.T
                if len(b) == 0:
                    self.to_drop.append(i)
                else:
                    self.data[i].to_pickle(r"C:\file\market_data\\" + i + ".pickle")
                    self.saved.append(i)
                    if b[0] < self.first_date:
                        self.first_date = b[0]
                    for ii in range(len(b)):
                        if b[ii] in self.date_manager.keys():
                            self.date_manager[b[ii]].append(i)
                        else:
                            self.date_manager[b[ii]] = [i]
        self.manage_date_manager()
        self.date_manager = pd.DataFrame(self.date_manager)
        self.date_manager.to_pickle(r"C:\file\market_data\\"+type+"_timeline.pickle")
        self.saved = pd.DataFrame(self.saved)
        self.saved.to_pickle(r"C:\Users\file\market_data\\"+type+"_saved.pickle")


def manage_date_manager(self):
    # Ensure self.date_manager is a DataFrame and pad shorter columns with 0
    if isinstance(self.date_manager, pd.DataFrame):
        # Find the maximum length among all columns
        max_len = max(len(self.date_manager[col]) for col in self.date_manager.columns)
        
        # Reindex or pad each column to match max_len using 0
        for col in self.date_manager.columns:
            current_len = len(self.date_manager[col])
            if current_len < max_len:
                # Create a padded series or fill values
                padding = pd.Series([0] * (max_len - current_len))
                self.date_manager[col] = pd.concat([self.date_manager[col].reset_index(drop=True), padding], ignore_index=True)


