        self.length = 10

    def initialize(self, type):
        # Explicitly reset self.date_manager as a standard dictionary at the start
        self.date_manager = {}

        for i in self.stocks:
            if not isinstance(i, str):
                pass
            else:
                self.data[i] = yf.download(i)
                b = self.data[i].index.T
                if len(b) == 0:
                    self.to_drop.append(i)
                else:
                    self.data[i].to_pickle(
                        r"C:\Users\#\PyCharmMiscProject\Trading_Engine\market_data\\"
                        + i
                        + ".pickle"
                    )
                    self.saved.append(i)
                    if b[0] < self.first_date:
                        self.first_date = b[0]
                    for ii in range(len(b)):
                        date_key = b[ii]
                        if date_key in self.date_manager:
                            self.date_manager[date_key].append(i)
                        else:
                            self.date_manager[date_key] = [i]

        # Pad lists using the safe dictionary method that avoids DataFrame append errors
        self.manage_date_manager()

        # Convert dictionary to DataFrame and save
        self.date_manager = pd.DataFrame(self.date_manager)
        self.date_manager.to_pickle(
            r"C:\Users\#\PyCharmMiscProject\Trading_Engine\market_data\\"
            + type
            + "_timeline.pickle"
        )

        self.saved = pd.DataFrame(self.saved)
        self.saved.to_pickle(
            r"C:\Users\#\PyCharmMiscProject\Trading_Engine\market_data\\"
            + type
            + "_saved.pickle"
        )

    def manage_date_manager(self):
        # If self.date_manager is accidentally a DataFrame, safely normalize it back to a dict of lists
        if isinstance(self.date_manager, pd.DataFrame):
            data_dict = {
                col: self.date_manager[col].dropna().tolist()
                for col in self.date_manager.columns
            }
        else:
            data_dict = self.date_manager

        # Find the maximum length among all date lists
        max_len = max(len(v) for v in data_dict.values())

        # Pad shorter lists with 0 so they are all uniform in length
        padded_dict = {
            k: v + [0] * (max_len - len(v)) for k, v in data_dict.items()
        }

        # Reassign back to self.date_manager as a dictionary ready for DataFrame conversion
        self.date_manager = padded_dict
        
        
